{
  "name": "final-ball",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @finalball/web dev",
    "build": "pnpm --filter @finalball/web build",
    "lint": "pnpm --filter @finalball/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r exec tsc --noEmit",
    "generate:tokens": "tsx scripts/build-tokens.ts"
  },
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
