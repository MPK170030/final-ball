# Supabase — get from Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sent as User-Agent on every FPL API request — identify the app politely
FPL_USER_AGENT=FinalBall/0.1 (+https://finalball.manavpkothari.dev)

# Added Thursday when the agent work starts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Public sample brief — owner's FPL team ID (from the FPL website URL or My Team page)
SAMPLE_TEAM_ID=
