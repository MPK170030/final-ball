# Supabase — get from Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL for OAuth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://finalball.manavpkothari.dev

# Sent as User-Agent on every FPL API request — identify the app politely
FPL_USER_AGENT=FinalBall/0.1 (+https://finalball.manavpkothari.dev)

# Added Thursday when the agent work starts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
